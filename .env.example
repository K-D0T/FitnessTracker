# Copy to .env and edit. .env is git-ignored -- never commit real secrets.

# Leave DJANGO_DEBUG=True for local development.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated. Defaults to localhost,127.0.0.1 while DEBUG is on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to your own zone, e.g. America/Denver. Bodyweight and workout dates are
# recorded in this timezone.
DJANGO_TIME_ZONE=UTC
